# Application overrides derived from dev-profile-alerts/overrides.env.
# Host paths, HOST_IP, and credentials are supplied by resolve.sh's environment.

FOUNDATION=alerts
COMPOSE_PROJECT_NAME=vss-woman-hailing
COMPOSE_PROFILES=nvstreamer-alerts,kibana-init-container-alerts,vss-video-analytics-api,alert-bridge,elasticsearch,elasticsearch-init-container,kafka,kafka-topic-init-container,redis,kibana,logstash,broker-health-check,vss-haproxy-ingress,rtvi-vlm,vss-ui,centralizedb,vst-ingress,sensor-ms,streamprocessing-ms
REQUESTED_PROFILES=
MODE=2d_vlm
HARDWARE_PROFILE=DGX-SPARK
LLM_DEVICE_ID=0
VLM_DEVICE_ID=0
RT_VLM_DEVICE_ID=0

EXTERNAL_IP=${HOST_IP}
VSS_PUBLIC_HOST=${HOST_IP}
VST_CONFIG_PATH=${VSS_APPS_DIR}/services/vios/configs
VST_NOTIFICATION_CONFIG_PATH=${VSS_APPS_DIR}/developer-profiles/dev-profile-alerts/vios/configs/notification_config_2d_vlm.json
VST_EXTERNAL_URL=http://${HOST_IP}:7777
VST_BASE_URL=${VST_EXTERNAL_URL}
VSS_AGENT_REPORTS_BASE_URL=http://${HOST_IP}:7777/static/
VSS_AGENT_EXTERNAL_URL=http://${HOST_IP}:7777

VLM_AS_VERIFIER_CONFIG_FILE=${VSS_APPS_DIR}/developer-profiles/dev-profile-alerts/vlm-as-verifier/configs/config.yml
VLM_AS_VERIFIER_CONFIG_FILE_REALTIME=${VSS_APPS_DIR}/applications/woman-hailing/realtime-config.yml
VLM_AS_VERIFIER_ALERT_TYPE_CONFIG_FILE=${VSS_APPS_DIR}/developer-profiles/dev-profile-alerts/vlm-as-verifier/configs/alert_type_config.json
ALERT_AGENT_ALWAYS_ON=true
NEXT_PUBLIC_APP_SUBTITLE="Woman Hailing — Built on NVIDIA Cosmos"
NEXT_PUBLIC_ENABLE_CHAT_SIDEBAR=false
NEXT_PUBLIC_ALERTS_TAB_MANAGE_ALERTS_SUB_TAB_ENABLE_CV_ALERTS_VERIFICATION=false

NVSTREAMER_CONFIG_DIR=${BUILD_DIR}/nvstreamer
RTVI_VLLM_GPU_MEMORY_UTILIZATION=0.40
RTVI_VLM_MAX_MODEL_LEN=32768
RTVI_VLLM_MAX_NUM_SEQS=2
RTVI_VLM_MAX_GENERATION_TOKENS=256
RTVI_VLM_BATCH_SIZE=2
NGC_MODEL_CACHE=${VSS_DATA_DIR}/models/ngc
RTVI_VLM_INPUT_WIDTH=640
RTVI_VLM_INPUT_HEIGHT=360
RTVI_VLM_KAFKA_ENABLED=true
RTVI_VLM_MESSAGE_BUS=kafka
RTVI_VLM_KAFKA_INCIDENT_TOPIC=mdx-vlm-incidents
RTVI_VLM_ERROR_MESSAGE_TOPIC=mdx-vlm-errors
INSTALL_PROPRIETARY_CODECS=true
